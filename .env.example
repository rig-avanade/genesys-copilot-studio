# Copy to .env locally. Never commit real values or paste secrets into chat.
PORT=8080
GENESYS_API_KEY=
KNOWLEDGE_API_KEY=
GENESYS_INTEGRATION_ID=
GENESYS_BOT_ID=qa-assistant
GENESYS_BOT_VERSION=v1

# Copy the correct regional Direct Line v3 endpoint and web-channel secret
# from your published Copilot Studio agent's connection configuration.
DIRECT_LINE_ENDPOINT=
DIRECT_LINE_SECRET=
TURN_TIMEOUT=20s

STORAGE_ENDPOINT=https://YOURACCOUNT.blob.core.windows.net
SESSION_CONTAINER=bot-sessions
KNOWLEDGE_CONTAINER=approved-knowledge
SEARCH_ENDPOINT=https://YOURSEARCH.search.windows.net
SEARCH_INDEX=customer-knowledge

# Only searchsetup needs this management-plane resource ID.
STORAGE_RESOURCE_ID=

# Only ingest needs these SharePoint settings.
SHAREPOINT_HOST=YOURTENANT.sharepoint.com
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=

# Azure identity: use az login for local Azure operations or managed identity
# in Azure. For a separate app registration, configure its credential securely
# using the Azure Identity SDK's AZURE_* environment variables, not this file.
